---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import ItemTable from '../components/ItemTable.astro';
import { SECTIONS, indexItems, listAll } from '../lib/content.mjs';
import { loadCore } from '../lib/coreReports.mjs';

const { prefix } = SECTIONS.reports;
const [core, reports] = await Promise.all([
  loadCore(env.CONTENT),
  listAll(env.CONTENT, prefix).then(objects => indexItems(objects, prefix)),
]);
---
<Base active="/" title="Yeo UX" subtitle="Your reports, one tap away.">
  {core.map(cluster => (
    <section class="mb-8">
      <h2 class="mb-3 text-lg font-semibold">{cluster.title}</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {cluster.items.map(entry => (
          <li>
            <a class="block min-h-11 rounded-box border border-base-300 p-3 hover:bg-base-200" href={entry.href}>
              <span class="block font-semibold">{entry.name}</span>
              <span class="mt-1 block text-sm text-base-content/60">{entry.line}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <section class="mb-8">
    <div class="mb-3 flex items-baseline justify-between gap-4">
      <h2 class="text-lg font-semibold">All reports</h2>
      <a class="link link-hover text-sm" href="/reports">All {reports.length}</a>
    </div>
    <ItemTable items={reports.slice(0, 8)} section="reports" />
    <p class="mt-3 text-sm"><a class="link link-hover" href="/explorations">Explorations</a></p>
  </section>
</Base>
