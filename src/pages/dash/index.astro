---
import Base from '../../layouts/Base.astro';
import { DASHBOARDS } from '../../lib/dash.mjs';

const boards = Object.values(DASHBOARDS);
---
<Base active="/dash" title="Dash">
  <ul class="space-y-4">
    {boards.map(board => (
      <li>
        <a class="link link-hover text-lg font-semibold" href={`/dash/${board.id}`}>{board.title}</a>
      </li>
    ))}
  </ul>
</Base>
